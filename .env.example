# ==============================================================================
# Multi-Tenant Task Management API - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO `.env` AND FILL IN YOUR ACTUAL SUPABASE CREDENTIALS.
# NEVER COMMIT THE REAL `.env` FILE OR ANY SERVICE_ROLE / SECRET KEYS.

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
# Example: https://xyzcompanyref.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable Key / Anon Key (Project Settings -> API -> Project API keys)
# Note: In modern Supabase projects this is called Publishable Key (`sbp_...`);
# legacy projects refer to it as Anon Key (`eyJ...`). Both are supported.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Environment (development, testing, production)
APP_ENV=development

# Optional: Host & Port configuration for local FastAPI server
HOST=0.0.0.0
PORT=8000
